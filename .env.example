# Base de datos PostgreSQL
POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@localhost:5434/DATABASE?schema=public"
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@localhost:5434/DATABASE?schema=public"

# Solo para Vercel Preview. Debe permanecer false en local y Producción.
PREVIEW_DATABASE_MIGRATIONS_ENABLED="false"

# Aplicación
APP_URL="http://localhost:3000"
# NO LEÍDA POR EL CÓDIGO. La zona horaria operativa está fijada en
# src/lib/automation-schedule.ts (ECUADOR_TIME_ZONE). Se documenta aquí como
# referencia; definirla en Vercel no cambia nada.
# APP_TIMEZONE="America/Guayaquil"
NEXT_PUBLIC_COURSE_CATALOG_URL="https://ra-training.com/courses-1/"
# URL oficial aprobada de privacidad. Vacia mantiene oculto el enlace hasta su publicacion.
NEXT_PUBLIC_PRIVACY_POLICY_URL=""
# Número internacional sin "+" ni ceros iniciales. Vacío oculta el botón público.
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# Sesiones administrativas
# Genera un valor largo y aleatorio. No reutilices una contraseña personal.
SESSION_SECRET=""
# Compatibilidad temporal con el acceso compartido anterior. Retirar después
# de crear usuarios administrativos individuales.
ADMIN_PASSWORD=""

# El valor true conserva la transición; cambiar a false después de migrar los accesos.
ADMIN_LEGACY_LOGIN_ENABLED="true"

# Automatización programada
CRON_SECRET=""

# Almacenamiento de recursos para publicaciones
BLOB_READ_WRITE_TOKEN=""

# Redes sociales mediante conectores oficiales
# simulation impide cualquier publicación real. Para habilitar Producción se
# requiere una revisión manual y el valor explícito live.
SOCIAL_MODE="simulation"
# Fecha de activación real de redes, ISO 8601 en UTC y con Z obligatoria
# (ejemplo: 2026-08-06T18:00:00Z). Solo se publica lo programado a partir de
# este momento; la cola atrasada queda visible pero nunca sale sola.
# Con SOCIAL_MODE=live y esta variable ausente o inválida, el publicador se
# bloquea de forma segura. En simulation no hace falta.
SOCIAL_LIVE_FROM=""
META_APP_ID=""
# NO LEÍDA POR EL CÓDIGO todavía. Reservada para webhooks o depuración de token.
META_APP_SECRET=""
META_BUSINESS_ID=""
META_PAGE_ID=""
META_INSTAGRAM_ACCOUNT_ID=""
META_GRAPH_API_VERSION="v25.0"
# Token del usuario del sistema. Debe marcarse Sensitive en Vercel.
META_SYSTEM_USER_TOKEN=""
# NO LEÍDA POR EL CÓDIGO todavía. Solo si se implementan webhooks.
META_WEBHOOK_VERIFY_TOKEN=""
# Cuenta publicitaria: sin asignar hoy. Las campañas pagadas quedan pendientes.
META_AD_ACCOUNT_ID=""
# Compatibilidad con despliegues anteriores. Si existen, se usan los nombres
# nuevos (META_SYSTEM_USER_TOKEN / META_INSTAGRAM_ACCOUNT_ID) de forma preferente.
META_ACCESS_TOKEN=""
META_IG_USER_ID=""

# TikTok Content Posting API (video). Mantener SELF_ONLY hasta aprobar la aplicación.
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REFRESH_TOKEN=""
# NO LEÍDAS POR EL CÓDIGO todavía: la integración de TikTok en el CRM está
# pendiente. Se documentan aquí porque ya están configuradas en el portal de
# TikTok; definirlas en Vercel hoy no tiene ningún efecto.
# TIKTOK_REDIRECT_URI="https://automatizacion-mkra-t2.vercel.app/api/integrations/tiktok/callback"
# TIKTOK_ENV="sandbox"
TIKTOK_PRIVACY="SELF_ONLY"

# Mensajería
# simulation es obligatorio fuera de Producción; live requiere habilitación explícita.
MESSAGING_MODE="simulation"
# Fecha de activación real del correo, ISO 8601 en UTC y con Z obligatoria
# (ejemplo: 2026-08-06T18:00:00Z). Solo se envía lo programado a partir de este
# momento; la cola atrasada queda visible pero nunca sale sola.
# Con MESSAGING_MODE=live y esta variable ausente o inválida, el procesador se
# bloquea de forma segura. En simulation no hace falta.
MESSAGING_LIVE_FROM=""

# Correo saliente. Proveedor principal: SMTP institucional de cPanel.
EMAIL_PROVIDER="smtp"
EMAIL_FROM="avillagomez@ra-training.com"
EMAIL_FROM_NAME="R.A. Training"
EMAIL_REPLY_TO="avillagomez@ra-training.com"
SMTP_HOST="mail.ra-training.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="avillagomez@ra-training.com"
# Debe marcarse Sensitive en Vercel. Nunca se escribe en el repositorio.
SMTP_PASSWORD=""
# Respaldo HTTP heredado (Resend). Solo se usa con EMAIL_PROVIDER="resend".
EMAIL_API_KEY=""

# ── WhatsApp Cloud API ───────────────────────────────────────────────────
# El canal es independiente del correo a propósito: apagar o encender WhatsApp
# nunca debe poner en riesgo el correo, que ya opera en real.
#
# Sin WHATSAPP_MODE el canal queda "disabled": ni envía ni simula. Es lo que
# debe pasar por omisión, porque heredar el modo del correo pondría WhatsApp en
# real el mismo día que se desplegara, sin que nadie lo pidiera.
#   disabled (o ausente) → no hace nada
#   simulation           → registra los mensajes como prueba, no contacta a Meta
#   live                 → envía de verdad; exige además WHATSAPP_LIVE_FROM
WHATSAPP_MODE="simulation"
# Momento (ISO 8601 en UTC) a partir del cual pueden salir mensajes reales.
# Existe para que pasar a live no vacíe de golpe la cola atrasada sobre los
# contactos: lo programado antes de esta fecha se queda sin enviar a propósito.
WHATSAPP_LIVE_FROM=""
# Identificador del número emisor. Va en Vercel, no en el repositorio.
WHATSAPP_PHONE_NUMBER_ID=""
# Token del usuario del sistema. Debe marcarse Sensitive en Vercel.
WHATSAPP_ACCESS_TOKEN=""
# Versión de Graph propia de este canal: subir la de Facebook/Instagram no
# arrastra a WhatsApp, ni al revés. Vacío usa la versión por defecto del CRM.
WHATSAPP_GRAPH_API_VERSION=""
# Número internacional del equipo humano, solo dígitos. Se usa únicamente en
# la respuesta de servicio a mensajes entrantes y genera https://wa.me/<número>.
WHATSAPP_HUMAN_SUPPORT_NUMBER=""
# La firma del webhook usa META_APP_SECRET y el alta usa META_WEBHOOK_VERIFY_TOKEN,
# ambos declarados más arriba. Sin ellos los mensajes se quedan en "Enviado" y
# nunca avanzan a "Entregado" ni "Leído".

# Moodle (webhook de finalización; deshabilitado mientras esté vacío)
MOODLE_WEBHOOK_SECRET=""

# R.A. Training Finance
# simulation es el modo obligatorio para desarrollo local. live solo se
# habilita en Producción después de validar permisos y contrato de integración.
FINANCE_MODE="simulation"
FINANCE_API_URL=""
FINANCE_APP_URL=""
FINANCE_USER=""
FINANCE_PASS=""
FINANCE_SERVICE_NAME=""
