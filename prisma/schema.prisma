generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(LECTURA)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignedLeads     Lead[]       @relation("LeadAssignee")
  notes             LeadNote[]
  assignedFollowUps FollowUp[]   @relation("FollowUpAssignee")
  auditLogs         AuditLog[]

  @@index([role, isActive])
  @@map("admin_users")
}

enum AdminRole {
  ADMIN
  MARKETING
  VENTAS
  LECTURA
}

model Course {
  id                String   @id @default(cuid())
  slug              String   @unique
  title             String
  subtitle          String?
  description       String?
  category          String?
  officialCourseUrl String   @default("https://ra-training.com/courses-1/")
  moodleCourseUrl   String?
  imageUrl          String?
  price             Decimal? @db.Decimal(10, 2)
  duration          String?
  modality          String?
  startsAt          DateTime?
  endsAt            DateTime?
  isFree            Boolean  @default(false)
  isPublished       Boolean  @default(false)
  isLeadMagnet      Boolean  @default(false)
  hasCertificate    Boolean  @default(false)
  displayOrder      Int      @default(0)
  benefits          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relacion historica. Se conserva temporalmente para compatibilidad.
  legacyLeads Lead[]
  enrollments Enrollment[]

  @@index([isPublished, displayOrder])
  @@index([category])
  @@map("courses")
}

model Lead {
  id                    String    @id @default(cuid())
  firstName             String?
  lastName              String?
  fullName              String
  email                 String
  phone                 String?
  source                String?
  utmSource             String?
  utmMedium             String?
  utmCampaign           String?
  landingUrl            String?
  referrer              String?
  consent               Boolean   @default(false)
  consentAt             DateTime?
  consentPolicyVersion  String?
  consentPurpose        String?
  stage                 LeadStage @default(NUEVO)
  assignedToId          String?
  isArchived            Boolean   @default(false)
  archivedAt            DateTime?
  lostReason            String?
  nextActionAt          DateTime?
  score                 Int       @default(0)
  scoreBreakdown        Json?
  scoredAt              DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Campos historicos: no se eliminan hasta completar la migracion productiva.
  courseId              String?
  financeInscripcionId  String?
  course                Course?   @relation(fields: [courseId], references: [id])

  assignedTo  AdminUser?        @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  enrollments Enrollment[]
  events      LeadEvent[]
  messages    OutboundMessage[]
  notes       LeadNote[]
  followUps   FollowUp[]

  @@index([stage, isArchived])
  @@index([email])
  @@index([score])
  @@index([phone])
  @@index([utmCampaign])
  @@index([assignedToId])
  @@map("leads")
}

enum LeadStage {
  NUEVO
  INSCRITO
  EN_CURSO
  CERTIFICADO
  OPORTUNIDAD
  CLIENTE
  PERDIDO
}

model Enrollment {
  id                       String            @id @default(cuid())
  leadId                   String
  courseId                 String
  status                   EnrollmentStatus @default(INTERESADO)
  source                   String?
  utmSource                String?
  utmMedium                String?
  utmCampaign              String?
  landingUrl               String?
  moodleEnrollmentId       String?
  moodleCompletionDate     DateTime?
  financeInscripcionId     String?           @unique
  financeStatus            FinanceStatus     @default(NO_ENVIADO)
  certificateStatus        CertificateStatus @default(DESCONOCIDO)
  handoffAttempts          Int               @default(0)
  lastHandoffError         String?
  lastHandoffAt            DateTime?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  lead     Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  course   Course            @relation(fields: [courseId], references: [id])
  events   LeadEvent[]
  messages OutboundMessage[]

  @@unique([leadId, courseId])
  @@index([courseId, status])
  @@index([financeStatus])
  @@map("enrollments")
}

enum EnrollmentStatus {
  INTERESADO
  INSCRITO
  EN_CURSO
  COMPLETADO
  CANCELADO
}

enum FinanceStatus {
  NO_ENVIADO
  PENDIENTE
  ENVIANDO
  ENVIADO
  ERROR
}

enum CertificateStatus {
  PENDIENTE
  EMITIDO
  ANULADO
  DESCONOCIDO
}

model LeadNote {
  id        String    @id @default(cuid())
  leadId    String
  authorId  String?
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  lead   Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author AdminUser? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@map("lead_notes")
}

model FollowUp {
  id           String         @id @default(cuid())
  leadId       String
  assignedToId String?
  type         FollowUpType
  dueAt        DateTime
  status       FollowUpStatus @default(PENDIENTE)
  notes        String?
  completedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  lead       Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedTo AdminUser? @relation("FollowUpAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([status, dueAt])
  @@index([leadId])
  @@map("follow_ups")
}

enum FollowUpType {
  LLAMADA
  WHATSAPP
  CORREO
  REUNION
  RECORDATORIO
  OTRO
}

enum FollowUpStatus {
  PENDIENTE
  COMPLETADO
  CANCELADO
  VENCIDO
}

model LeadEvent {
  id             String      @id @default(cuid())
  leadId         String
  enrollmentId   String?
  type           String
  payload        Json?
  idempotencyKey String?     @unique
  createdAt      DateTime    @default(now())

  lead       Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  enrollment Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@index([enrollmentId])
  @@map("lead_events")
}

model AuditLog {
  id         String    @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String
  entityType String
  entityId   String?
  result     String
  metadata   Json?
  createdAt  DateTime  @default(now())

  actor AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model OutboundMessage {
  id           String        @id @default(cuid())
  leadId       String
  enrollmentId String?
  templateId   String?
  channel      MessageChannel
  toAddress    String
  subject      String?
  body         String
  status       MessageStatus @default(PROGRAMADO)
  scheduledAt  DateTime
  sentAt       DateTime?
  cancelledAt  DateTime?
  error        String?
  sequenceKey  String?
  stepKey      String?
  attempts     Int           @default(0)
  isSimulation Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  lead       Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  enrollment Enrollment?      @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  template   MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([status, scheduledAt])
  @@index([leadId])
  @@index([enrollmentId])
  @@unique([leadId, enrollmentId, sequenceKey, stepKey])
  @@map("outbound_messages")
}

enum MessageChannel {
  EMAIL
  WHATSAPP
}

enum MessageStatus {
  PROGRAMADO
  ENVIANDO
  ENVIADO
  SIMULADO
  FALLIDO
  CANCELADO
  OMITIDO
}

model MessageTemplate {
  id                 String         @id @default(cuid())
  name               String
  channel            MessageChannel
  subject            String?
  body               String
  isActive           Boolean        @default(true)
  category           String?
  availableVariables Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  messages OutboundMessage[]

  @@index([channel, isActive])
  @@map("message_templates")
}

model SocialAccount {
  id          String         @id @default(cuid())
  platform    SocialPlatform
  displayName String
  externalId  String?
  accessToken String?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  posts     SocialPost[]
  schedules SocialSchedule[]

  @@unique([platform, externalId])
  @@index([isActive])
  @@map("social_accounts")
}

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  TIKTOK
  YOUTUBE
  LINKEDIN
}

model SocialPost {
  id               String         @id @default(cuid())
  accountId        String
  caption          String
  mediaUrl         String?
  linkUrl          String?
  status           PostStatus     @default(BORRADOR)
  scheduledAt      DateTime?
  publishStartedAt DateTime?
  publishedAt      DateTime?
  cancelledAt      DateTime?
  externalPostId   String?
  error            String?
  retryCount       Int            @default(0)
  scheduleId       String?
  occurrenceKey    String?         @unique
  duplicatedFromId String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  account        SocialAccount   @relation(fields: [accountId], references: [id])
  schedule       SocialSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  duplicatedFrom SocialPost?     @relation("PostDuplicates", fields: [duplicatedFromId], references: [id], onDelete: SetNull)
  duplicates     SocialPost[]    @relation("PostDuplicates")

  @@index([status, scheduledAt])
  @@index([scheduleId])
  @@map("social_posts")
}

enum PostStatus {
  BORRADOR
  PROGRAMADO
  PUBLICANDO
  PUBLICADO
  SIMULADO
  FALLIDO
  CANCELADO
}

model SocialSchedule {
  id          String        @id @default(cuid())
  accountId   String
  name        String
  caption     String
  mediaUrl    String?
  linkUrl     String?
  weekday     Int
  localTime   String
  timezone    String        @default("America/Guayaquil")
  isActive    Boolean       @default(true)
  nextRunAt   DateTime
  lastRunAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  account SocialAccount @relation(fields: [accountId], references: [id])
  posts   SocialPost[]

  @@index([isActive, nextRunAt])
  @@map("social_schedules")
}
