generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(LECTURA)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignedLeads     Lead[]     @relation("LeadAssignee")
  notes             LeadNote[]
  assignedFollowUps FollowUp[] @relation("FollowUpAssignee")
  auditLogs         AuditLog[]

  @@index([role, isActive])
  @@map("admin_users")
}

enum AdminRole {
  /// Perfil tecnico: ve el diagnostico, las integraciones y la auditoria.
  ADMIN
  /// Perfil de direccion: hace todo lo operativo y administrativo, pero no ve
  /// la sala de maquinas. No es un permiso reducido, es otra superficie.
  DIRECCION
  MARKETING
  VENTAS
  LECTURA
}

model Course {
  id                           String            @id @default(cuid())
  slug                         String            @unique
  title                        String
  subtitle                     String?
  description                  String?
  category                     String?
  officialCourseUrl            String            @default("https://ra-training.com/courses-1/")
  courseCompleteUrl            String?
  whatsappGroupUrl             String?
  surveyUrl                    String?
  moodleCourseUrl              String?
  imageUrl                     String?
  price                        Decimal?          @db.Decimal(10, 2)
  /// Precios y destinos de las tres modalidades comerciales del mismo curso de
  /// 60 horas. Se guardan por curso porque el precio inicial es de lanzamiento
  /// y va a cambiar; la logica NUNCA decide la modalidad por el importe.
  fullOfferPrice               Decimal?          @db.Decimal(10, 2)
  institutionalOfferPrice      Decimal?          @db.Decimal(10, 2)
  upgradeOfferPrice            Decimal?          @db.Decimal(10, 2)
  institutionalOfferUrl        String?
  upgradeOfferUrl              String?
  /// Horas de espera tras el ultimo de los once mensajes antes de la oferta
  /// institucional automatica. Configurable: 24 h es el valor de partida, no
  /// una constante del codigo.
  institutionalOfferDelayHours Int               @default(24)
  /// Pausa de las automatizaciones de este curso.
  ///
  /// Hasta ahora la unica forma de callar un curso era despublicarlo, lo que
  /// ademas lo retira de la web publica. Con esto se detienen sus envios sin
  /// tocar los de los demas cursos y sin ocultarlo. No borra nada: al reanudar,
  /// las reglas y el historial siguen donde estaban.
  automationsPausedAt          DateTime?
  automationsPausedBy          String?
  duration                     String?
  modality                     String?
  startsAt                     DateTime?
  endsAt                       DateTime?
  streamUrl                    String?
  isFree                       Boolean           @default(false)
  isPublished                  Boolean           @default(false)
  acceptsRegistrations         Boolean           @default(false)
  isLeadMagnet                 Boolean           @default(false)
  hasCertificate               Boolean           @default(false)
  displayOrder                 Int               @default(0)
  benefits                     Json?
  externalId                   String?
  externalSource               String?
  officialSlug                 String?
  crmSlug                      String?           @unique
  officialUrl                  String?
  lastSyncedAt                 DateTime?
  sourceUpdatedAt              DateTime?
  syncStatus                   CatalogSyncStatus @default(NEVER_SYNCED)
  syncError                    String?
  createdAt                    DateTime          @default(now())
  updatedAt                    DateTime          @updatedAt

  // Relacion historica. Se conserva temporalmente para compatibilidad.
  legacyLeads     Lead[]
  enrollments     Enrollment[]
  campaigns       Campaign[]
  automationRules AutomationRule[]
  sessions        CourseSession[]
  offerCampaigns  CertificationOfferCampaign[]

  @@unique([externalSource, externalId])
  @@index([isPublished, displayOrder])
  @@index([category])
  @@index([syncStatus])
  @@map("courses")
}

/// Sesiones reales de un curso o taller. Un curso puede tener varias fechas y
/// reutilizar el mismo enlace de transmision entre ellas. Si un curso no tiene
/// sesiones registradas, el CRM sigue usando `startsAt`/`endsAt` del curso como
/// una sesion unica virtual (ver src/lib/course-sessions.ts).
model CourseSession {
  id        String    @id @default(cuid())
  courseId  String
  title     String?
  startAt   DateTime
  endAt     DateTime?
  streamUrl String?
  timezone  String    @default("America/Guayaquil")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  course   Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  messages OutboundMessage[]

  @@index([courseId, startAt])
  @@index([startAt])
  @@map("course_sessions")
}

enum CatalogSyncStatus {
  NEVER_SYNCED
  SYNCED
  CONFLICT
  ERROR
  HISTORICAL
}

model Lead {
  id                   String             @id @default(cuid())
  firstName            String?
  lastName             String?
  fullName             String
  email                String
  phone                String?
  source               String?
  utmSource            String?
  utmMedium            String?
  utmCampaign          String?
  utmContent           String?
  utmTerm              String?
  landingUrl           String?
  referrer             String?
  consent              Boolean            @default(false)
  consentAt            DateTime?
  consentPolicyVersion String?
  consentPurpose       String?
  classification       LeadClassification @default(UNKNOWN)
  stage                LeadStage          @default(NUEVO)
  assignedToId         String?
  isArchived           Boolean            @default(false)
  archivedAt           DateTime?
  lostReason           String?
  nextActionAt         DateTime?
  score                Int                @default(0)
  scoreBreakdown       Json?
  scoredAt             DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  // Campos historicos: no se eliminan hasta completar la migracion productiva.
  courseId             String?
  financeInscripcionId String?
  course               Course? @relation(fields: [courseId], references: [id])

  assignedTo  AdminUser?        @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  enrollments Enrollment[]
  events      LeadEvent[]
  messages    OutboundMessage[]
  notes       LeadNote[]
  followUps   FollowUp[]

  @@index([stage, isArchived])
  @@index([classification, isArchived])
  @@index([email])
  @@index([score])
  @@index([phone])
  @@index([utmCampaign])
  @@index([utmContent])
  @@index([utmTerm])
  @@index([assignedToId])
  @@map("leads")
}

enum LeadClassification {
  REAL
  TEST
  DEMO
  UNKNOWN
}

enum LeadStage {
  NUEVO
  INSCRITO
  EN_CURSO
  CERTIFICADO
  OPORTUNIDAD
  CLIENTE
  PERDIDO
}

model Enrollment {
  id                         String            @id @default(cuid())
  leadId                     String
  courseId                   String
  campaignId                 String?
  status                     EnrollmentStatus  @default(INTERESADO)
  source                     String?
  utmSource                  String?
  utmMedium                  String?
  utmCampaign                String?
  utmContent                 String?
  utmTerm                    String?
  landingUrl                 String?
  referrer                   String?
  moodleEnrollmentId         String?
  moodleCompletionDate       DateTime?
  financeInscripcionId       String?           @unique
  financeStatus              FinanceStatus     @default(NO_ENVIADO)
  certificateStatus          CertificateStatus @default(DESCONOCIDO)
  handoffAttempts            Int               @default(0)
  lastHandoffError           String?
  lastHandoffAt              DateTime?
  /// Derecho de acceso al curso completo de 60 horas.
  ///
  /// Se concede cuando Finance confirma PAYMENT_VERIFIED, que es la unica
  /// fuente de verdad del pago en el sistema nuevo. NO implica matricula en
  /// Moodle: hoy no existe una API de matriculacion y afirmarlo seria mentir.
  fullCourseAccessEntitled   Boolean           @default(false)
  fullCourseAccessEntitledAt DateTime?
  /// Nivel de certificacion vigente segun las compras verificadas.
  effectiveCertificationTier CertificationTier @default(NONE)
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  lead            Lead                          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  course          Course                        @relation(fields: [courseId], references: [id])
  campaign        Campaign?                     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  events          LeadEvent[]
  messages        OutboundMessage[]
  purchases       CoursePurchase[]
  offerRecipients CertificationOfferRecipient[]

  @@unique([leadId, courseId])
  @@index([courseId, status])
  @@index([campaignId])
  @@index([financeStatus])
  @@map("enrollments")
}

model Campaign {
  id          String         @id @default(cuid())
  name        String
  code        String         @unique
  courseId    String?
  status      CampaignStatus @default(DRAFT)
  source      String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  course          Course?          @relation(fields: [courseId], references: [id], onDelete: SetNull)
  enrollments     Enrollment[]
  automationRules AutomationRule[]

  @@index([status, startsAt])
  @@index([courseId])
  @@map("campaigns")
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum EnrollmentStatus {
  INTERESADO
  INSCRITO
  EN_CURSO
  COMPLETADO
  CANCELADO
}

enum FinanceStatus {
  NO_ENVIADO
  PENDIENTE
  ENVIANDO
  ENVIADO
  ERROR
}

enum CertificateStatus {
  PENDIENTE
  EMITIDO
  ANULADO
  DESCONOCIDO
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  authorId  String?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead   Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author AdminUser? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@map("lead_notes")
}

model FollowUp {
  id           String         @id @default(cuid())
  leadId       String
  assignedToId String?
  type         FollowUpType
  dueAt        DateTime
  status       FollowUpStatus @default(PENDIENTE)
  notes        String?
  completedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  lead       Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedTo AdminUser? @relation("FollowUpAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([status, dueAt])
  @@index([leadId])
  @@map("follow_ups")
}

enum FollowUpType {
  LLAMADA
  WHATSAPP
  CORREO
  REUNION
  RECORDATORIO
  OTRO
}

enum FollowUpStatus {
  PENDIENTE
  COMPLETADO
  CANCELADO
  VENCIDO
}

model LeadEvent {
  id             String   @id @default(cuid())
  leadId         String
  enrollmentId   String?
  type           String
  payload        Json?
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  lead       Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  enrollment Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@index([enrollmentId])
  @@map("lead_events")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String
  entityType String
  entityId   String?
  result     String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model OutboundMessage {
  id                String         @id @default(cuid())
  leadId            String
  enrollmentId      String?
  courseSessionId   String?
  templateId        String?
  channel           MessageChannel
  toAddress         String
  subject           String?
  body              String
  status            MessageStatus  @default(PROGRAMADO)
  scheduledAt       DateTime
  sentAt            DateTime?
  acceptedAt        DateTime?
  deliveredAt       DateTime?
  /// Solo WhatsApp. Meta lo reporta con el estado `read` del webhook.
  readAt            DateTime?
  bouncedAt         DateTime?
  failedAt          DateTime?
  cancelledAt       DateTime?
  error             String?
  errorCode         String?
  errorMessage      String?
  providerName      String?
  providerMessageId String?
  providerResponse  Json?
  /// Plantilla de WhatsApp con sus parametros ya resueltos, tal como se
  /// enviaran a Meta: {name, language, components}. Se calcula al programar,
  /// de modo que el historial guarda exactamente lo que se envio y no una
  /// reconstruccion posterior. Siempre null en los mensajes de correo.
  waTemplate        Json?
  sequenceKey       String?
  stepKey           String?
  attempts          Int            @default(0)
  attemptCount      Int            @default(0)
  lastAttemptAt     DateTime?
  nextAttemptAt     DateTime?
  isSimulation      Boolean        @default(false)
  automationRuleId  String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  lead           Lead                   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  enrollment     Enrollment?            @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  courseSession  CourseSession?         @relation(fields: [courseSessionId], references: [id], onDelete: SetNull)
  template       MessageTemplate?       @relation(fields: [templateId], references: [id], onDelete: SetNull)
  automationRule AutomationRule?        @relation(fields: [automationRuleId], references: [id], onDelete: SetNull)
  providerEvents MessageProviderEvent[]

  @@unique([leadId, enrollmentId, sequenceKey, stepKey])
  @@index([status, scheduledAt])
  @@index([leadId])
  @@index([enrollmentId])
  @@index([courseSessionId])
  @@index([automationRuleId])
  @@index([providerMessageId])
  @@map("outbound_messages")
}

enum MessageChannel {
  EMAIL
  WHATSAPP
}

enum MessageStatus {
  PROGRAMADO
  ENVIANDO
  ACEPTADO
  ENVIADO
  ENTREGADO
  /// Solo WhatsApp lo reporta. El correo nunca alcanza este estado: confirmar
  /// la lectura de un correo exige pixeles de rastreo que no usamos.
  LEIDO
  REBOTADO
  SIMULADO
  FALLIDO
  CANCELADO
  OMITIDO
}

model MessageProviderEvent {
  id              String    @id @default(cuid())
  messageId       String
  provider        String
  providerEventId String?
  type            String
  payload         Json?
  occurredAt      DateTime?
  receivedAt      DateTime  @default(now())

  message OutboundMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([provider, providerEventId])
  @@index([messageId, receivedAt])
  @@map("message_provider_events")
}

model AutomationRule {
  id                 String            @id @default(cuid())
  courseId           String
  campaignId         String?
  name               String
  trigger            AutomationTrigger
  offsetMinutes      Int               @default(0)
  channel            MessageChannel
  subject            String?
  body               String
  status             AutomationStatus  @default(DRAFT)
  /// Marca las reglas que solo tienen sentido con enlace de transmision (por
  /// ejemplo el recordatorio de 15 minutos). Sin enlace el mensaje se registra
  /// como OMITIDO con un motivo claro en lugar de enviarse vacio.
  requiresStreamUrl  Boolean           @default(false)
  /// Identificador estable del plan estandar de correos ("welcome",
  /// "reminder_24h", ...). Permite reaplicar el plan sin duplicar reglas.
  planKey            String?
  /// Nombre exacto de la plantilla aprobada en Meta. Obligatorio en las reglas
  /// de WhatsApp iniciadas por la empresa: sin ventana de servicio abierta,
  /// Meta rechaza cualquier texto libre. Siempre null en las reglas de correo.
  waTemplateName     String?
  /// Codigo de idioma de la plantilla tal como se registro en Meta ("es").
  waTemplateLanguage String?
  /// Orden EXACTO de las variables del cuerpo: el elemento 0 alimenta {{1}}.
  /// Son claves de TEMPLATE_VARIABLES, no textos ya resueltos.
  waTemplateBodyVars Json?
  /// Variable que rellena el sufijo del boton de URL dinamica, si la plantilla
  /// declara uno. Meta fija el prefijo en la plantilla y solo acepta el sufijo.
  waTemplateUrlVar   String?
  enrollmentStatuses Json?
  lastExecutedAt     DateTime?
  nextExecutionAt    DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  course   Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  campaign Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  messages OutboundMessage[]

  // El canal forma parte de la identidad del paso: un curso tiene la
  // bienvenida por correo Y la bienvenida por WhatsApp, y ambas comparten
  // `planKey` porque son el mismo momento del plan.
  @@unique([courseId, channel, planKey])
  @@index([status, nextExecutionAt])
  @@index([courseId, trigger])
  @@index([campaignId])
  @@map("automation_rules")
}

enum AutomationTrigger {
  ON_REGISTRATION
  BEFORE_COURSE
  AFTER_COURSE
}

enum AutomationStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

model MessageTemplate {
  id                 String         @id @default(cuid())
  name               String
  channel            MessageChannel
  subject            String?
  body               String
  isActive           Boolean        @default(true)
  category           String?
  availableVariables Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  messages OutboundMessage[]

  @@index([channel, isActive])
  @@map("message_templates")
}

model SocialAccount {
  id          String         @id @default(cuid())
  platform    SocialPlatform
  displayName String
  externalId  String?
  /// Campo histórico en texto plano. NO se escribe desde el flujo OAuth: los
  /// tokens nuevos viven cifrados en `accessTokenCipher`/`refreshTokenCipher`.
  accessToken String?

  // --- Conexión OAuth por cuenta (TikTok Login Kit) ---
  /// Identificador estable del usuario en el proveedor.
  openId                String?
  nickname              String?
  avatarUrl             String?
  /// Scopes realmente concedidos por la persona usuaria.
  grantedScopes         Json?
  /// AES-256-GCM con versión de formato. Nunca en texto plano.
  accessTokenCipher     String?
  refreshTokenCipher    String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  /// Versión del formato de cifrado, para poder rotar la clave.
  tokenVersion          Int       @default(1)
  connectedAt           DateTime?
  refreshedAt           DateTime?
  disconnectedAt        DateTime?
  lastErrorCode         String?
  lastErrorMessage      String?

  isActive            Boolean                @default(true)
  connectionStatus    SocialConnectionStatus @default(UNKNOWN)
  connectionCheckedAt DateTime?
  connectionError     String?
  tokenExpiresAt      DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  posts          SocialPost[]
  schedules      SocialSchedule[]
  tiktokBusiness TikTokBusinessConnection?

  @@unique([platform, externalId])
  @@index([isActive])
  @@index([platform, openId])
  @@map("social_accounts")
}

/// Conexión independiente de TikTok for Business / Accounts API.
/// Los tokens legacy de Login Kit permanecen en SocialAccount y nunca se
/// mezclan con estas credenciales.
model TikTokBusinessConnection {
  id                    String                 @id @default(cuid())
  socialAccountId       String                 @unique
  businessId            String                 @unique
  username              String?
  displayName           String?
  avatarUrl             String?
  grantedScopes         Json?
  accessTokenCipher     String?
  refreshTokenCipher    String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  tokenVersion          Int                    @default(1)
  status                SocialConnectionStatus @default(UNKNOWN)
  connectedAt           DateTime?
  refreshedAt           DateTime?
  disconnectedAt        DateTime?
  connectionCheckedAt   DateTime?
  lastErrorCode         String?
  lastErrorMessage      String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Restrict)

  @@index([status])
  @@map("tiktok_business_connections")
}

enum SocialConnectionStatus {
  UNKNOWN
  SIMULATION
  READY
  EXPIRED
  DISCONNECTED
  MISSING_PERMISSION
  /// El refresh token caducó o fue revocado: hace falta volver a autorizar.
  REAUTH_REQUIRED
  ERROR
}

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  TIKTOK
  YOUTUBE
  LINKEDIN
}

model SocialPost {
  id                String     @id @default(cuid())
  accountId         String
  caption           String
  mediaUrl          String?
  linkUrl           String?
  status            PostStatus @default(BORRADOR)
  scheduledAt       DateTime?
  publishStartedAt  DateTime?
  publishedAt       DateTime?
  cancelledAt       DateTime?
  externalPostId    String?
  /// Identificador que devuelve TikTok al iniciar la publicación o la carga.
  /// No equivale a "publicado": el estado real se consulta con status/fetch.
  publishId         String?
  /// Último estado informado por el proveedor (PROCESSING, PUBLISH_COMPLETE...).
  providerStatus    String?
  providerPostUrl   String?
  providerResponse  Json?
  error             String?
  errorCode         String?
  errorMessage      String?
  retryCount        Int        @default(0)
  archivedAt        DateTime?
  deletedLocallyAt  DateTime?
  providerDeletedAt DateTime?
  scheduleId        String?
  occurrenceKey     String?    @unique
  duplicatedFromId  String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  account        SocialAccount   @relation(fields: [accountId], references: [id])
  schedule       SocialSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  duplicatedFrom SocialPost?     @relation("PostDuplicates", fields: [duplicatedFromId], references: [id], onDelete: SetNull)
  duplicates     SocialPost[]    @relation("PostDuplicates")

  @@index([status, scheduledAt])
  @@index([scheduleId])
  @@index([publishId])
  @@map("social_posts")
}

enum PostStatus {
  BORRADOR
  PROGRAMADO
  PUBLICANDO
  ACEPTADO
  PUBLICADO
  SIMULADO
  FALLIDO
  CANCELADO
  ARCHIVADO
  ELIMINADO_LOCAL
  ELIMINADO_PROVEEDOR
}

model CatalogSyncRun {
  id          String            @id @default(cuid())
  source      String
  status      CatalogSyncStatus @default(NEVER_SYNCED)
  discovered  Int               @default(0)
  created     Int               @default(0)
  updated     Int               @default(0)
  conflicts   Int               @default(0)
  errors      Int               @default(0)
  error       String?
  metadata    Json?
  startedAt   DateTime          @default(now())
  completedAt DateTime?

  @@index([source, startedAt])
  @@map("catalog_sync_runs")
}

model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
  @@map("rate_limit_buckets")
}

model SocialSchedule {
  id        String    @id @default(cuid())
  accountId String
  name      String
  caption   String
  mediaUrl  String?
  linkUrl   String?
  weekday   Int
  localTime String
  timezone  String    @default("America/Guayaquil")
  isActive  Boolean   @default(true)
  nextRunAt DateTime
  lastRunAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  account SocialAccount @relation(fields: [accountId], references: [id])
  posts   SocialPost[]

  @@index([isActive, nextRunAt])
  @@map("social_schedules")
}

// ─── Arquitectura comercial: compras del curso de 60 horas ──────────────────
//
// La compra es una entidad SEPARADA de Enrollment. Enrollment es la inscripcion
// academica y su unicidad (leadId + courseId) no cambia: una persona sigue
// teniendo una sola inscripcion por curso. Lo que puede tener varias es
// compras: la institucional y, mas tarde, la mejora con aval externo.

enum CoursePurchaseType {
  FULL
  INSTITUTIONAL
  AVAL_UPGRADE
}

enum CoursePurchaseStatus {
  PENDING
  SENT_TO_FINANCE
  PAYMENT_PENDING
  PAYMENT_VERIFIED
  CANCELLED
  ERROR
}

/// Nivel de certificacion al que da derecho lo que la persona pago.
enum CertificationTier {
  NONE
  INSTITUTIONAL
  FULL
}

/// Estado comercial que devuelve Finance. Se guarda tal cual lo informa, sin
/// interpretarlo: es su fuente de verdad, no la nuestra.
enum FinanceCommercialState {
  NO_PURCHASE
  FULL_PENDING
  FULL_VERIFIED
  INSTITUTIONAL_PENDING
  INSTITUTIONAL_VERIFIED
  UPGRADE_PENDING
  FULL_UPGRADED
  CANCELLED
  LEGACY_UNCLASSIFIED
}

model CoursePurchase {
  id           String               @id @default(cuid())
  enrollmentId String
  offerType    CoursePurchaseType
  amount       Decimal              @db.Decimal(10, 2)
  status       CoursePurchaseStatus @default(PENDING)

  /// Obligatorio en AVAL_UPGRADE: la compra institucional que se mejora. Sin el,
  /// una mejora quedaria huerfana y Finance no podria validar el encadenamiento.
  parentPurchaseId String?

  financeInscripcionId   String?
  financePaymentStatus   String?
  paymentVerifiedAt      DateTime?
  financeCommercialState FinanceCommercialState?

  lastFinanceSyncAt DateTime?
  lastFinanceError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollment Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  parent     CoursePurchase?  @relation("UpgradeDeParent", fields: [parentPurchaseId], references: [id], onDelete: SetNull)
  upgrades   CoursePurchase[] @relation("UpgradeDeParent")

  @@index([enrollmentId, offerType])
  @@index([status])
  @@index([financeInscripcionId])
  @@map("course_purchases")
}

// ─── Campaña de oferta de certificacion institucional ───────────────────────

/// Como se decide a quien se envia.
///
/// La distincion es la razon de ser de este modelo. En los cursos historicos no
/// existe CRMCompras, asi que deducir quien compro a partir del importe o del
/// estado heredado seria inventar; ahi decide una persona. En los cursos nuevos
/// Finance si es fuente de verdad y el envio puede automatizarse.
enum CampaignAudienceMode {
  HISTORICAL_MANUAL
  AUTOMATIC_COMMERCE
}

enum CertificationOfferStatus {
  DRAFT
  SCHEDULED
  RUNNING
  COMPLETED
  CANCELLED
}

/// Situacion de cada destinatario dentro de la campaña.
enum OfferRecipientEligibility {
  PENDING
  ELIGIBLE
  NOT_ELIGIBLE_PURCHASED
  NOT_ELIGIBLE_PENDING_PAYMENT
  REQUIRES_REVIEW
  EXCLUDED
  SENT
  ERROR
}

model CertificationOfferCampaign {
  id           String                   @id @default(cuid())
  courseId     String
  audienceMode CampaignAudienceMode
  status       CertificationOfferStatus @default(DRAFT)

  /// Momento calculado para el envio automatico: fin real de los once mensajes
  /// mas `institutionalOfferDelayHours`. Nulo en las campañas historicas.
  automaticScheduledAt DateTime?
  automaticExecutedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course     Course                        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  recipients CertificationOfferRecipient[]

  /// Una sola campaña de oferta institucional por curso: dos campañas sobre la
  /// misma audiencia acabarian escribiendo dos veces a la misma persona.
  @@unique([courseId])
  @@index([status, automaticScheduledAt])
  @@map("certification_offer_campaigns")
}

model CertificationOfferRecipient {
  id           String @id @default(cuid())
  campaignId   String
  enrollmentId String

  eligibilityStatus OfferRecipientEligibility @default(PENDING)

  /// Fotografia de lo que Finance dijo en la ultima consulta. Es informativa:
  /// en modo historico NO decide nada, solo se muestra.
  commercialStateSnapshot      FinanceCommercialState?
  effectiveEntitlementSnapshot CertificationTier?

  manuallyApprovedAt DateTime?
  manuallyApprovedBy String?
  manualExcludedAt   DateTime?
  manualExcludedBy   String?

  manualSentAt    DateTime?
  automaticSentAt DateTime?
  messageId       String?

  lastEligibilityCheckAt DateTime?
  exclusionReason        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign   CertificationOfferCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  enrollment Enrollment                 @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([campaignId, enrollmentId])
  @@index([campaignId, eligibilityStatus])
  @@map("certification_offer_recipients")
}
