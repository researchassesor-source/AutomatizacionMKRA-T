{
  "name": "automatizacion-mkra-t",
  "version": "0.1.0",
  "private": true,
  "description": "Motor de automatizacion de marketing y ventas para RA-Training (ra-training.com)",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "node scripts/vercel-build.mjs",
    "start": "next start",
    "lint": "biome lint .",
    "smoke:release": "tsx --env-file=.env scripts/release-smoke.ts",
    "smoke:catalog": "tsx --env-file=.env scripts/course-catalog-smoke.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "admin:create": "tsx scripts/create-admin.ts",
    "report:demo-data": "tsx --env-file=.env scripts/demo-data-report.ts",
    "report:preflight": "tsx --env-file=.env scripts/deploy-preflight.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@vercel/blob": "^2.6.1",
    "next": "^15.5.22",
    "nodemailer": "^7.0.13",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^7.0.12",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.24",
      "sharp": "$sharp"
    }
  }
}
